# Backend Configuration
PORT=5000
NODE_ENV=development

# Database
MONGODB_URI="Mongo db credential"

# Security
JWT_SECRET=super_secret_jwt_access_key_aura_health_2026
JWT_REFRESH_SECRET=super_secret_jwt_refresh_key_Medi_Bridge_2026
JWT_EXPIRES_IN=1d
JWT_REFRESH_EXPIRES_IN=7d

# AI Service (Google Gemini or OpenAI key - optional, system has intelligent structured fallback)
LLM_API_KEY=mock_llm_key_for_dev

# Email Notifications (SMTP configuration - system logs cleanly if not provided)
EMAIL_HOST=smtp.mailtrap.io
EMAIL_PORT=2525
EMAIL_USER=mock_user
EMAIL_PASSWORD=mock_pass
EMAIL_FROM=notifications@MediBridge.com

# Google Calendar Integration (OAuth 2.0 Client Credentials)
GOOGLE_CLIENT_ID=mock_google_client_id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=mock_google_client_secret
GOOGLE_REDIRECT_URI=http://localhost:5000/api/google-calendar/callback

# Queue & Background Workers
REDIS_URL=redis://localhost:6379

# Booking Configuration
SLOT_HOLD_DURATION_MINUTES=5

# URLs
FRONTEND_URL=http://localhost:3000
BACKEND_URL=http://localhost:5000
